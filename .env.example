# Incident Response Agent Configuration Template
PROJECT_NAME="Incident Response Agent"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./incident_agent.db"

# Telemetry & Monitoring
PROMETHEUS_URL="http://localhost:9090"
SIMULATION_MODE=true
KUBERNETES_IN_CLUSTER=false

# LLM & Reasoning
LLM_MODEL="gemini-1.5-pro"
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Human-in-the-loop Notification & Escalation
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
PAGERDUTY_ROUTING_KEY="your-pagerduty-routing-key"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
